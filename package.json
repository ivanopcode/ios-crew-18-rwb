{
  "name": "ios-crew-18-rwb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "iOS Crew #18 & RWB — presentation as code (Slidev)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "slidev --open",
    "start": "slidev",
    "build": "slidev build",
    "export": "slidev export --output .temp/export/ios-crew-18-rwb.pdf",
    "export:pptx": "slidev export --format pptx --output .temp/export/ios-crew-18-rwb.pptx",
    "notes": "slidev export-notes --output .temp/export/notes.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "vue": "^3.5.13"
  }
}
